#!/bin/bash
set -euo pipefail
key="${1:-}"
remote="$HOME/.local/bin/hands-remote"
file="${AUTHORIZED_KEYS:-$HOME/.ssh/authorized_keys}"

if [[ "$key" == *$'\n'* ]] || ! [[ "$key" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))\ [A-Za-z0-9+/=]+(\ .*)?$ ]]; then
  echo "Uso: authorize-phone 'ssh-ed25519 AAAA...'" >&2
  exit 64
fi
body="$(printf '%s' "$key" | /usr/bin/awk '{print $1" "$2}')"
printf '%s\n' "$body" | /usr/bin/ssh-keygen -l -f - >/dev/null
[ -x "$remote" ] || { echo "Falta $remote: corre make install" >&2; exit 1; }

umask 077
/bin/mkdir -p "$(/usr/bin/dirname "$file")"
/usr/bin/touch "$file"
if /usr/bin/grep -qF -- "$body" "$file"; then
  echo "Esa llave ya está en $file; no la cambié" >&2
  exit 1
fi
[ -s "$file" ] && [ -n "$(/usr/bin/tail -c1 "$file")" ] && echo >> "$file"
printf 'restrict,command="%s" %s hands-iphone\n' "$remote" "$body" >> "$file"
echo "Llave autorizada solo para on, off y status"
